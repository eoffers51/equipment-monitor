# clang-tidy config for `idf.py clang-check` (esp-clang). Conservative set for embedded C:
# static-analyzer paths, bug-prone patterns, and a few readability checks that catch real
# mistakes. Style is handled by .clang-format, not here.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  performance-*,
  readability-braces-around-statements,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-declaration,
  readability-uppercase-literal-suffix
WarningsAsErrors: ''
# Only report diagnostics in this project's own headers, not in ESP-IDF or managed components.
HeaderFilterRegex: 'equipment-monitor[/\\](components|main|host_test)[/\\].*'
FormatStyle: file
